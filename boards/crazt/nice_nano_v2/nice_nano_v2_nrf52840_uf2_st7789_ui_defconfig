CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y
CONFIG_USB_DEVICE_REMOTE_WAKEUP=n

CONFIG_USB_DEVICE_MANUFACTURER="Crazt"
CONFIG_USB_DEVICE_PRODUCT="SlimeNRF Receiver nice!nano v2 ST7789"

# Generate for Adafruit nRF52 UF2 bootloader flashing.
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_BUILD_OUTPUT_UF2_FAMILY_ID="0xADA52840"
CONFIG_FLASH_LOAD_OFFSET=0x1000

CONFIG_SLIMENRF_DISPLAY_UI=y

CONFIG_SPI=y
CONFIG_PWM=y
CONFIG_DISPLAY=y
CONFIG_MIPI_DBI=y
CONFIG_MIPI_DBI_SPI=y
CONFIG_ST7789V=y
CONFIG_ST7789V_RGB565=y

CONFIG_INPUT=y
CONFIG_INPUT_GPIO_KEYS=y

CONFIG_LVGL=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_Z_BITS_PER_PIXEL=16
CONFIG_LV_Z_VDB_SIZE=10
CONFIG_LV_Z_BUFFER_ALLOC_STATIC=y
CONFIG_LV_Z_MEM_POOL_SIZE=16384
CONFIG_LV_Z_KEYPAD_INPUT=y
CONFIG_LV_Z_KEYPAD_INPUT_MSGQ_COUNT=8
CONFIG_LV_USE_LABEL=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y

CONFIG_DISPLAY_LOG_LEVEL_ERR=y
CONFIG_MIPI_DBI_LOG_LEVEL_WRN=y
CONFIG_LV_USE_LOG=n
